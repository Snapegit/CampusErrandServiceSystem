<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.PaotuiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.PaotuiEntity" id="paotuiMap">
        <result property="paotuizhanghao" column="paotuizhanghao"/>
        <result property="mima" column="mima"/>
        <result property="paotuixingming" column="paotuixingming"/>
        <result property="xingbie" column="xingbie"/>
        <result property="shenfenzheng" column="shenfenzheng"/>
        <result property="paotuishouji" column="paotuishouji"/>
        <result property="touxiang" column="touxiang"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.PaotuiView" >

		SELECT  paotui.* FROM paotui  paotui 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.PaotuiView" >
		SELECT * FROM paotui  paotui <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
